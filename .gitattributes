# Normalize line endings for text files
* text=auto

# Keep Python and Markdown files consistent across platforms
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.sh text eol=lf

# Preserve Windows batch scripts with CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
